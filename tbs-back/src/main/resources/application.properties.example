# Configuration générale de l'application
spring.application.name=travel-buddy-split

# Configuration de la source de données
spring.datasource.url= jdbc:postgresql://localhost:5432/'mettre nom bdd'
spring.datasource.username= 'mettre nom utilisateur bdd'
spring.datasource.password= 'mettre mot de passe bdd'
spring.datasource.driver-class-name=org.postgresql.Driver

# Configuration JPA / Hibernate
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

# Configuration Flyway
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true